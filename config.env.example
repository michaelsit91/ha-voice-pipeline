# ── Home Assistant ────────────────────────────────────────────────────────────
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_ha_long_lived_token_here

# ── Ollama (local LLM) ────────────────────────────────────────────────────────
OLLAMA_URL=http://homeassistant.local:11434
MODEL=default

# ── VRAM Manager (optional) ───────────────────────────────────────────────────
# When set, Ollama calls are routed through the vram-manager proxy
# (VRAM_MANAGER_URL/ollama/...) so it has visibility into in-flight requests.
# VRAM_MANAGER_URL=http://192.168.68.250:8890

# ── Container ─────────────────────────────────────────────────────────────────
PORT=18795

# ── API authentication (optional) ─────────────────────────────────────────────
# When set, POST /v1/chat/completions and POST /reload require X-API-Key: <value>.
# Leave empty to disable authentication (default for private LAN use).
API_KEY=

# ── Timezone (for log timestamps) ─────────────────────────────────────────────
# TZ string: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=UTC
TZ_OFFSET_HOURS=0

# ── Zigbee/Z-Wave propagation delay ───────────────────────────────────────────
# Time (ms) to wait after a service call before re-reading device state.
# Increase if state reads return stale values after commands.
ZIGBEE_PROPAGATION_MS=400

# ── Music Assistant (optional) ────────────────────────────────────────────────
# config_entry_id from HA Settings → Devices & Services → Music Assistant → ⚙ → Copy entry ID
MA_CONFIG_ENTRY_ID=your_music_assistant_config_entry_id_here

# ── Spotify Connect sync (optional) ───────────────────────────────────────────
# Absolute path to Music Assistant's data directory on the HOST (for the volume mount).
# Example: /opt/homeassistant/music-assistant/data
MA_DATA_PATH=/path/to/music-assistant/data
# Path to MA's settings.json INSIDE the container (must match the volume mount).
# Leave empty to disable Spotify Connect sync.
MA_SETTINGS_JSON=/ma-data/settings.json
# Name of the Librespot device as it appears in the Spotify app
LIBRESPOT_DEVICE_NAME=ReSpeaker Lite
